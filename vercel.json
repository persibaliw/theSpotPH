{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/homepage.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/api.php?action=$1"
    },
    {
      "source": "/track.php",
      "destination": "/api/track.php"
    }
  ]
}
