{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.0"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/homepage.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/api.php?action=$1"
    }
  ]
}
